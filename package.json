{
  "name": "aurora-business-lab",
  "version": "1.0.0",
  "description": "Aurora Business Lab - Simulador empresarial multiplayer para ensinar análise de dados",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "electron": "electron .",
    "build:win": "npx electron-builder --win --x64",
    "build:portable": "npx electron-builder --win portable --x64",
    "build:linux": "npx electron-builder --linux --x64",
    "build:mac": "npx electron-builder --mac",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false"
  },
  "keywords": [
    "business-simulation",
    "multiplayer",
    "education",
    "data-analytics",
    "accounting"
  ],
  "author": "Aurora Hub",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.5.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^25.1.8",
    "vitest": "^3.0.5"
  },
  "build": {
    "electronVersion": "44.7.2",
    "appId": "com.aurorahub.businesslab",
    "productName": "Aurora Business Lab",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "views/**/*",
      "package.json",
      "!**/*.sqlite",
      "!**/*.sqlite-shm",
      "!**/*.sqlite-wal",
      "!dist/**",
      "!build.bat",
      "!build.sh",
      "!scripts/**",
      "!tests/**",
      "!test/**",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!.git/**",
      "!.github/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portatil.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  }
}
