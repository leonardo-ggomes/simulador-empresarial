<script>
// Lista sequencial das diretorias executivas (sem CDO)
const DIRETORES = ['cmo', 'coo', 'cfo', 'panorama'];
let diretoriaAtiva = 'cmo';

// Alternar entre abas com transição suave GSAP
function trocarDiretoria(nome) {
  if (!DIRETORES.includes(nome)) return;
  diretoriaAtiva = nome;

  // Atualiza estado visual dos botões do trilho
  DIRETORES.forEach(d => {
    const btn = document.getElementById(`tab-btn-${d}`);
    const panel = document.getElementById(`panel-${d}`);
    if (btn) {
      if (d === nome) {
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
      } else {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
      }
    }
    if (panel) {
      if (d === nome) {
        panel.classList.remove('hidden');
        if (typeof gsap !== 'undefined') {
          gsap.fromTo(panel, 
            { opacity: 0, y: 6 }, 
            { opacity: 1, y: 0, duration: 0.18, ease: 'power2.out' }
          );
        }
      } else {
        panel.classList.add('hidden');
      }
    }
  });

  atualizarCalculos();
}

function navegarDiretoria(delta) {
  const currentIndex = DIRETORES.indexOf(diretoriaAtiva);
  let nextIndex = currentIndex + delta;
  if (nextIndex < 0) nextIndex = DIRETORES.length - 1;
  if (nextIndex >= DIRETORES.length) nextIndex = 0;
  trocarDiretoria(DIRETORES[nextIndex]);
}

// Sincronização em duas vias: Input numérico -> Slider
function sincronizarInput(campo, valor) {
  const range = document.getElementById(`range-${campo}`);
  if (range) range.value = valor;
  atualizarCalculos();
}

// Sincronização em duas vias: Slider -> Input numérico
function sincronizarSlider(campo, valor) {
  const input = document.getElementById(`dec-${campo}`);
  if (input) input.value = valor;
  atualizarCalculos();
}

// Aplicação de chips de preset em 1 clique
function aplicarPreset(campo, valor) {
  const input = document.getElementById(`dec-${campo}`);
  const range = document.getElementById(`range-${campo}`);
  if (input) input.value = valor;
  if (range) range.value = valor;
  atualizarCalculos();
  if (typeof gsap !== 'undefined' && input) {
    gsap.fromTo(input, { scale: 1.04 }, { scale: 1, duration: 0.15 });
  }
}

// Motor de Cálculo em Tempo Real & Atualização de Telemetrias
function atualizarCalculos() {
  const preco = parseFloat(document.getElementById('dec-preco')?.value) || 0;
  const mkt = parseFloat(document.getElementById('dec-marketing')?.value) || 0;
  const cNormal = parseInt(document.getElementById('dec-compra-normal')?.value, 10) || 0;
  const cUrgente = parseInt(document.getElementById('dec-compra-urgente')?.value, 10) || 0;
  const emprestimo = parseFloat(document.getElementById('dec-solicitar-emprestimo')?.value) || 0;
  const amortizacao = parseFloat(document.getElementById('dec-amortizar-emprestimo')?.value) || 0;

  const custoUnitMedio = 35.00;
  const custoUrgenteUnit = custoUnitMedio * 1.30;
  const desembolsoComprasNormal = cNormal * custoUnitMedio;
  const desembolsoComprasUrgente = cUrgente * custoUrgenteUnit;
  const desembolsoComprasTotal = desembolsoComprasNormal + desembolsoComprasUrgente;
  const totalDesembolsos = mkt + desembolsoComprasTotal + amortizacao;
  const totalIngressos = emprestimo;

  // 1. Telemetrias no Trilho de Abas
  const railCMO = document.getElementById('rail-telemetry-cmo');
  if (railCMO) railCMO.textContent = `R$ ${preco.toFixed(2).replace('.', ',')} • R$ ${Math.round(mkt).toLocaleString('pt-BR')}`;

  const railCOO = document.getElementById('rail-telemetry-coo');
  if (railCOO) railCOO.textContent = `${cNormal.toLocaleString('pt-BR')} un • ${cUrgente.toLocaleString('pt-BR')} urg`;

  const railCFO = document.getElementById('rail-telemetry-cfo');
  if (railCFO) railCFO.textContent = `+R$ ${Math.round(emprestimo).toLocaleString('pt-BR')} • -R$ ${Math.round(amortizacao).toLocaleString('pt-BR')}`;

  // 2. Micro-KPIs CMO
  const elMargem = document.getElementById('kpi-margem-unitaria');
  if (elMargem) {
    const margem = preco - custoUnitMedio;
    elMargem.textContent = `R$ ${margem.toFixed(2).replace('.', ',')} / un`;
    elMargem.className = margem > 0 ? 'text-sm font-bold text-slate-900 font-mono' : 'text-sm font-bold text-rose-600 font-mono';
  }
  const elDesembolsoMkt = document.getElementById('kpi-desembolso-mkt');
  if (elDesembolsoMkt) elDesembolsoMkt.textContent = `R$ ${mkt.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const elPos = document.getElementById('kpi-posicionamento-preco');
  if (elPos) {
    const deltaPerc = ((preco - 80.00) / 80.00) * 100;
    elPos.textContent = `${deltaPerc >= 0 ? '+' : ''}${deltaPerc.toFixed(1)}% vs Mercado`;
  }

  // 3. Micro-KPIs COO
  const elTotalUn = document.getElementById('kpi-total-unidades-compras');
  if (elTotalUn) elTotalUn.textContent = `${(cNormal + cUrgente).toLocaleString('pt-BR')} unidades`;

  const elCustoCompras = document.getElementById('kpi-custo-total-compras');
  if (elCustoCompras) elCustoCompras.textContent = `R$ ${desembolsoComprasTotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const elAgio = document.getElementById('kpi-agio-emergencial');
  if (elAgio) {
    const agio = cUrgente * (custoUrgenteUnit - custoUnitMedio);
    elAgio.textContent = `Ágio emergencial: R$ ${agio.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
  }

  const elCmvPond = document.getElementById('kpi-cmv-ponderado');
  if (elCmvPond) {
    const totalUn = cNormal + cUrgente;
    const ponderado = totalUn > 0 ? (desembolsoComprasTotal / totalUn) : custoUnitMedio;
    elCmvPond.textContent = `R$ ${ponderado.toFixed(2).replace('.', ',')} / un`;
  }

  // 4. Micro-KPIs CFO
  const elIngresso = document.getElementById('kpi-ingressos-tesouraria');
  if (elIngresso) elIngresso.textContent = `+ R$ ${emprestimo.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const elAmort = document.getElementById('kpi-desembolso-amortizacao');
  if (elAmort) elAmort.textContent = `R$ ${amortizacao.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const elVarDiv = document.getElementById('kpi-variacao-liquida-divida');
  if (elVarDiv) {
    const varLiq = emprestimo - amortizacao;
    elVarDiv.textContent = `${varLiq >= 0 ? '+' : ''} R$ ${varLiq.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
    elVarDiv.className = varLiq <= 0 ? 'text-sm font-bold text-emerald-600 font-mono' : 'text-sm font-bold text-slate-900 font-mono';
  }

  // 5. Dock Inferior
  const dockDesembolso = document.getElementById('dock-desembolso-total');
  if (dockDesembolso) dockDesembolso.textContent = `R$ ${totalDesembolsos.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const dockCaptacao = document.getElementById('dock-captacao-total');
  if (dockCaptacao) dockCaptacao.textContent = `+ R$ ${totalIngressos.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  // 6. Resumo Consolidado (Painel Panorama)
  const resPreco = document.getElementById('resumo-preco');
  if (resPreco) resPreco.textContent = `R$ ${preco.toFixed(2).replace('.', ',')}`;

  const resMkt = document.getElementById('resumo-mkt');
  if (resMkt) resMkt.textContent = `R$ ${mkt.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const resCNormal = document.getElementById('resumo-compra-normal');
  if (resCNormal) resCNormal.textContent = `${cNormal.toLocaleString('pt-BR')} un`;

  const resCUrgente = document.getElementById('resumo-compra-urgente');
  if (resCUrgente) resCUrgente.textContent = `${cUrgente.toLocaleString('pt-BR')} un`;

  const resEmp = document.getElementById('resumo-emprestimo');
  if (resEmp) resEmp.textContent = `+ R$ ${emprestimo.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  const resAmort = document.getElementById('resumo-amortizacao');
  if (resAmort) resAmort.textContent = `- R$ ${amortizacao.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
}

// Side Sheet 1: Previsão de Desembolso & Fluxo Contábil
function abrirPreviaImpacto() {
  const preco = parseFloat(document.getElementById('dec-preco').value) || 0;
  const mkt = parseFloat(document.getElementById('dec-marketing').value) || 0;
  const cNormal = parseInt(document.getElementById('dec-compra-normal').value, 10) || 0;
  const cUrgente = parseInt(document.getElementById('dec-compra-urgente').value, 10) || 0;
