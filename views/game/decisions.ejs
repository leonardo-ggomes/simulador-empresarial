        <p class="text-slate-500 mt-0.5">Visão consolidada das saídas imediatas e captações contratadas para a Rodada <%= currentRoom.rodada_atual %>:</p>
      </div>

      <!-- Tabela Contábil Editorial -->
      <div class="border border-slate-200 rounded-lg overflow-hidden bg-white">
        <div class="px-3.5 py-2 bg-slate-50 border-b border-slate-200 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          Desembolsos Operacionais Previstos
        </div>
        <div class="p-3.5 space-y-2 text-xs">
          <div class="flex justify-between items-baseline">
            <span class="text-slate-600">Investimento em Marketing (CMO):</span>
            <span class="font-mono text-slate-900">R$ ${mkt.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-slate-600">Estoque Programado (${cNormal.toLocaleString('pt-BR')} un @ R$ 35,00):</span>
            <span class="font-mono text-slate-900">R$ ${comprasNormais.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-slate-600">Estoque Emergencial (${cUrgente.toLocaleString('pt-BR')} un @ R$ 45,50):</span>
            <span class="font-mono text-slate-900">R$ ${comprasUrgentes.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-slate-600">Amortização de Empréstimos (CFO):</span>
            <span class="font-mono text-slate-900">R$ ${amortizacao.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
          </div>
          <div class="pt-2.5 border-t border-slate-200 flex justify-between items-baseline font-bold text-slate-900">
            <span>Total de Saídas Operacionais:</span>
            <span class="font-mono text-rose-600">R$ ${totalDesembolsos.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
          </div>
        </div>
      </div>

      <!-- Ingressos de Tesouraria -->
      <div class="p-3.5 bg-emerald-50/60 border border-emerald-200 rounded-lg flex justify-between items-center text-xs">
        <div>
          <div class="font-bold text-emerald-950">Captação de Empréstimo Solicitada</div>
          <div class="text-[11px] text-emerald-700">Entrada imediata de liquidez em conta corrente</div>
        </div>
        <span class="font-mono text-emerald-700 font-bold text-sm">+ R$ ${totalIngressos.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
      </div>

      <!-- Saldo Preliminar -->
