  const totalDesembolsos = mkt + desembolsoCompras + amortizacao;
  const totalIngressos = emprestimo;
  const saldoOperacionalPrevisto = totalIngressos - totalDesembolsos;

  const html = `
    <div class="space-y-5 text-xs">
      <div>
