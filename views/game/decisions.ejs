<div class="space-y-6 pb-20" data-sala-id="<%= currentRoom.id %>" data-equipe-id="<%= currentTeam.id %>" data-rodada="<%= currentRoom.rodada_atual %>" data-sala-codigo="<%= currentRoom.codigo %>">

  <!-- Header Executivo Slim da Rodada -->
  <div class="app-card p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-status badge-status-neutral font-mono text-[11px]">
          Rodada <%= currentRoom.rodada_atual %> de <%= currentRoom.max_rodadas || 12 %>
        </span>
        <span class="badge-status badge-status-neutral font-semibold text-[11px]">
          <%= currentTeam.nome %>
        </span>
        <% if (decisionStatus === 'enviada') { %>
          <span class="badge-status badge-status-success font-semibold text-[11px]">
            ● Decisão Homologada pelo CEO
          </span>
        <% } else { %>
          <span class="badge-status badge-status-warning font-semibold text-[11px]">
            ○ Em Formulação (Rascunho)
          </span>
        <% } %>
        <span id="sync-indicator" class="text-[10px] text-slate-400 flex items-center gap-1 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Tempo Real
        </span>
      </div>
      <h1 class="text-lg font-bold text-slate-900 tracking-tight">
        Painel de Deliberação Executiva
      </h1>
      <p class="text-xs text-slate-500 max-w-2xl">
        Configure as decisões estratégicas por diretoria. Acompanhe a telemetria operacional em tempo real antes da homologação final.
      </p>
    </div>

    <!-- Ações Auxiliares Rápidas (Side Sheets) -->
    <div class="flex items-center gap-2 self-stretch md:self-auto">
      <button type="button" onclick="abrirPreviaImpacto()" class="btn-secondary text-xs flex items-center gap-1.5 flex-1 md:flex-initial">
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span>Simulação de Desembolso</span>
      </button>
      <button type="button" onclick="abrirGuiaDiretorias()" class="btn-secondary text-xs flex items-center gap-1.5" title="Regras de mercado e benchmarks">
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="hidden sm:inline">Benchmarks</span>
      </button>
      <a href="/sala/<%= currentRoom.id %>/powerbi" class="btn-secondary text-xs text-blue-600 border-blue-200 hover:bg-blue-50/50 flex items-center gap-1" title="Consultar dados no Power BI">
        <span>Power BI</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>

  <!-- Trilho Executivo Slim (Segmented Navigation Rail) -->
  <div class="decision-rail" role="tablist" aria-label="Diretorias Executivas">
    
    <!-- Tab 1: CMO -->
    <button type="button" role="tab" id="tab-btn-cmo" aria-selected="true" aria-controls="panel-cmo" onclick="trocarDiretoria('cmo')" class="decision-rail-btn active group">
      <div class="flex items-center justify-between w-full">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 group-hover:text-slate-800">CMO</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="Parâmetros configurados"></span>
      </div>
      <div class="text-xs font-semibold text-slate-900 truncate">Comercial & Vendas</div>
      <span class="rail-telemetry-badge" id="rail-telemetry-cmo">R$ 80,00 • R$ 2.500</span>
    </button>

    <!-- Tab 2: COO -->
    <button type="button" role="tab" id="tab-btn-coo" aria-selected="false" aria-controls="panel-coo" onclick="trocarDiretoria('coo')" class="decision-rail-btn group">
      <div class="flex items-center justify-between w-full">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 group-hover:text-slate-800">COO</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="Parâmetros configurados"></span>
      </div>
      <div class="text-xs font-semibold text-slate-900 truncate">Operações & Estoque</div>
      <span class="rail-telemetry-badge" id="rail-telemetry-coo">1.000 un • 0 urg</span>
    </button>

    <!-- Tab 3: CFO -->
    <button type="button" role="tab" id="tab-btn-cfo" aria-selected="false" aria-controls="panel-cfo" onclick="trocarDiretoria('cfo')" class="decision-rail-btn group">
      <div class="flex items-center justify-between w-full">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 group-hover:text-slate-800">CFO</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="Parâmetros configurados"></span>
      </div>
      <div class="text-xs font-semibold text-slate-900 truncate">Finanças & Crédito</div>
      <span class="rail-telemetry-badge" id="rail-telemetry-cfo">R$ 0 • R$ 0</span>
    </button>

    <!-- Tab 4: Visão Consolidada -->
    <button type="button" role="tab" id="tab-btn-panorama" aria-selected="false" aria-controls="panel-panorama" onclick="trocarDiretoria('panorama')" class="decision-rail-btn group border-l border-slate-200">
      <div class="flex items-center justify-between w-full">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 group-hover:text-slate-800">VISÃO GERAL</span>
        <svg class="w-3 h-3 text-slate-400 group-hover:text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
      </div>
      <div class="text-xs font-semibold text-slate-900 truncate">Panorama Geral</div>
      <span class="rail-telemetry-badge">Todas as Diretorias</span>
    </button>

  </div>

  <!-- Formulário Central de Submissão -->
  <form id="form-decisoes" onsubmit="handleSalvarDecisao(event, 'enviada')" class="space-y-6">

    <!-- ====================================================================
         PAINEL 1: DIRETORIA COMERCIAL (CMO)
         ==================================================================== -->
    <div id="panel-cmo" role="tabpanel" class="app-card p-6 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded">CMO</span>
            <h2 class="text-sm font-bold text-slate-900 tracking-tight">Diretoria Comercial & Mercado</h2>
          </div>
          <p class="text-xs text-slate-500">Defina a precificação unitária do produto e a verba de tração comercial para o trimestre.</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <span>Ref. Mercado: <strong class="text-slate-700">R$ 80,00</strong></span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Bloco 1.1: Preço Unitário -->
        <div class="space-y-3.5 p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800" for="dec-preco">
              Preço Unitário de Venda
            </label>
            <div class="text-[11px] font-mono text-slate-500" id="cmo-preco-display">
              R$ <%= Number(currentDecision.payload?.preco || 80).toFixed(2).replace('.', ',') %>
            </div>
          </div>

          <div class="input-addon-group">
            <span class="input-addon-affix">R$</span>
            <input type="number" step="0.50" min="20" max="300" id="dec-preco" required value="<%= currentDecision.payload?.preco || 80.00 %>" oninput="sincronizarInput('preco', this.value)">
          </div>

          <!-- Slider Slim -->
          <div class="space-y-1">
            <input type="range" class="slider-slim" min="20" max="300" step="0.50" id="range-preco" value="<%= currentDecision.payload?.preco || 80.00 %>" oninput="sincronizarSlider('preco', this.value)">
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>Mín R$ 20</span>
              <span>Benchmark R$ 80</span>
              <span>Máx R$ 300</span>
            </div>
          </div>

          <!-- Presets Rápidos -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1">
            <span class="text-[10px] text-slate-400 font-medium">Presets:</span>
            <button type="button" class="preset-chip" onclick="aplicarPreset('preco', 65.00)">R$ 65,00 (Competitivo)</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('preco', 80.00)">R$ 80,00 (Neutro)</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('preco', 95.00)">R$ 95,00 (Premium)</button>
          </div>
        </div>

        <!-- Bloco 1.2: Verba de Marketing -->
        <div class="space-y-3.5 p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800" for="dec-marketing">
              Investimento em Marketing
            </label>
            <div class="text-[11px] font-mono text-slate-500" id="cmo-mkt-display">
              R$ <%= Number(currentDecision.payload?.marketing || 2500).toLocaleString('pt-BR') %>
            </div>
          </div>

          <div class="input-addon-group">
            <span class="input-addon-affix">R$</span>
            <input type="number" step="100" min="0" max="50000" id="dec-marketing" required value="<%= currentDecision.payload?.marketing || 2500 %>" oninput="sincronizarInput('marketing', this.value)">
          </div>

          <!-- Slider Slim -->
          <div class="space-y-1">
            <input type="range" class="slider-slim" min="0" max="50000" step="100" id="range-marketing" value="<%= currentDecision.payload?.marketing || 2500 %>" oninput="sincronizarSlider('marketing', this.value)">
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>R$ 0</span>
              <span>Padrão R$ 2.500</span>
              <span>Máx R$ 50.000</span>
            </div>
          </div>

          <!-- Presets Rápidos -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1">
            <span class="text-[10px] text-slate-400 font-medium">Presets:</span>
            <button type="button" class="preset-chip" onclick="aplicarPreset('marketing', 1000)">R$ 1.000 (Mínimo)</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('marketing', 2500)">R$ 2.500 (Médio)</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('marketing', 5000)">R$ 5.000 (Agressivo)</button>
          </div>
        </div>

      </div>

      <!-- Micro-Telemetria Comercial Slim -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <div class="micro-kpi-card">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Margem Bruta Unitária Estimada</span>
          <span class="text-sm font-bold text-slate-900 font-mono" id="kpi-margem-unitaria">R$ 45,00 / un</span>
          <span class="text-[10px] text-slate-500">Baseada no CMV médio de R$ 35,00</span>
        </div>
        <div class="micro-kpi-card">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Desembolso de Atração</span>
          <span class="text-sm font-bold text-slate-900 font-mono" id="kpi-desembolso-mkt">R$ 2.500,00</span>
          <span class="text-[10px] text-slate-500">Sujeito a curva de rendimentos decrescentes</span>
        </div>
        <div class="micro-kpi-card">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Posicionamento Relativo</span>
          <span class="text-sm font-bold text-slate-900 font-mono" id="kpi-posicionamento-preco">0% vs Mercado</span>
          <span class="text-[10px] text-slate-500">Elasticidade-preço estimada em ~ -1.25</span>
        </div>
      </div>
    </div>

    <!-- ====================================================================
         PAINEL 2: DIRETORIA DE OPERAÇÕES & ESTOQUE (COO)
         ==================================================================== -->
    <div id="panel-coo" role="tabpanel" class="app-card p-6 space-y-6 hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded">COO</span>
            <h2 class="text-sm font-bold text-slate-900 tracking-tight">Operações, Suprimentos & Cadeia Produtiva</h2>
          </div>
          <p class="text-xs text-slate-500">Planeje a aquisição de lotes normais com lead-time regular e compras emergenciais para proteção imediata.</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <span>CMV Unitário Base: <strong class="text-slate-700">R$ 35,00</strong></span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Bloco 2.1: Compra Normal -->
        <div class="space-y-3.5 p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800" for="dec-compra-normal">
              Compra Programada de Lotes
            </label>
            <div class="text-[11px] font-mono text-slate-500" id="coo-normal-display">
              <%= Number(currentDecision.payload?.compraEstoqueNormal || 1000).toLocaleString('pt-BR') %> unidades
            </div>
          </div>

          <div class="input-addon-group">
            <input type="number" step="50" min="0" max="5000" id="dec-compra-normal" required value="<%= currentDecision.payload?.compraEstoqueNormal || 1000 %>" oninput="sincronizarInput('compra-normal', this.value)">
            <span class="input-addon-affix border-r-0 border-l border-slate-200">unidades</span>
          </div>

          <!-- Slider Slim -->
          <div class="space-y-1">
            <input type="range" class="slider-slim" min="0" max="5000" step="50" id="range-compra-normal" value="<%= currentDecision.payload?.compraEstoqueNormal || 1000 %>" oninput="sincronizarSlider('compra-normal', this.value)">
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>0 un</span>
              <span>1.000 un (Padrão)</span>
              <span>5.000 un</span>
            </div>
          </div>

          <!-- Presets Rápidos -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1">
            <span class="text-[10px] text-slate-400 font-medium">Presets:</span>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-normal', 500)">500 un</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-normal', 1000)">1.000 un</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-normal', 1500)">1.500 un</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-normal', 2500)">2.500 un</button>
          </div>
          <p class="text-[11px] text-slate-400">Entrega garantida para a próxima rodada (lead-time industrial padrão).</p>
        </div>

        <!-- Bloco 2.2: Compra Emergencial -->
        <div class="space-y-3.5 p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800" for="dec-compra-urgente">
              Compra Emergencial (Pronta Entrega)
            </label>
            <div class="text-[11px] font-mono text-slate-500" id="coo-urgente-display">
              <%= Number(currentDecision.payload?.compraEstoqueUrgente || 0).toLocaleString('pt-BR') %> unidades
            </div>
          </div>

          <div class="input-addon-group">
            <input type="number" step="50" min="0" max="2000" id="dec-compra-urgente" value="<%= currentDecision.payload?.compraEstoqueUrgente || 0 %>" oninput="sincronizarInput('compra-urgente', this.value)">
            <span class="input-addon-affix border-r-0 border-l border-slate-200">unidades</span>
          </div>

          <!-- Slider Slim -->
          <div class="space-y-1">
            <input type="range" class="slider-slim" min="0" max="2000" step="50" id="range-compra-urgente" value="<%= currentDecision.payload?.compraEstoqueUrgente || 0 %>" oninput="sincronizarSlider('compra-urgente', this.value)">
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>0 un (Recomendado)</span>
              <span>1.000 un</span>
              <span>2.000 un</span>
            </div>
          </div>

          <!-- Presets Rápidos -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1">
            <span class="text-[10px] text-slate-400 font-medium">Presets:</span>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-urgente', 0)">0 un (Sem ágio)</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-urgente', 200)">200 un</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('compra-urgente', 500)">500 un</button>
          </div>
          <p class="text-[11px] text-slate-400">Disponibilidade imediata com acréscimo de +30% (R$ 45,50/unidade).</p>
        </div>

      </div>

      <!-- Micro-Telemetria Operacional Slim -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <div class="micro-kpi-card">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Total de Insumos Encomendados</span>
          <span class="text-sm font-bold text-slate-900 font-mono" id="kpi-total-unidades-compras">1.000 unidades</span>
          <span class="text-[10px] text-slate-500">Volume físico programado</span>
        </div>
        <div class="micro-kpi-card">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Desembolso Total com Suprimentos</span>
          <span class="text-sm font-bold text-slate-900 font-mono text-rose-600" id="kpi-custo-total-compras">R$ 35.000,00</span>
          <span class="text-[10px] text-slate-500" id="kpi-agio-emergencial">Ágio emergencial: R$ 0,00</span>
        </div>
        <div class="micro-kpi-card">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Custo Médio Unitário Ponderado</span>
          <span class="text-sm font-bold text-slate-900 font-mono" id="kpi-cmv-ponderado">R$ 35,00 / un</span>
          <span class="text-[10px] text-slate-500">Impactará o CPV dos próximos períodos</span>
        </div>
      </div>
    </div>

    <!-- ====================================================================
         PAINEL 3: DIRETORIA FINANCEIRA (CFO)
         ==================================================================== -->
    <div id="panel-cfo" role="tabpanel" class="app-card p-6 space-y-6 hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded">CFO</span>
            <h2 class="text-sm font-bold text-slate-900 tracking-tight">Finanças, Tesouraria & Estrutura de Capital</h2>
          </div>
          <p class="text-xs text-slate-500">Gerencie a liquidez de curto prazo através de empréstimos com o Banco Aurora ou amortize dívidas onerosas.</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <span>Banco Aurora: <strong class="text-emerald-700">Linha Aberta</strong></span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Bloco 3.1: Captação de Empréstimo -->
        <div class="space-y-3.5 p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800" for="dec-solicitar-emprestimo">
              Captação de Capital de Giro (Novo Empréstimo)
            </label>
            <div class="text-[11px] font-mono text-emerald-600 font-semibold" id="cfo-emprestimo-display">
              + R$ <%= Number(currentDecision.payload?.solicitarEmprestimo || 0).toLocaleString('pt-BR') %>
            </div>
          </div>

          <div class="input-addon-group">
            <span class="input-addon-affix">R$</span>
            <input type="number" step="1000" min="0" max="100000" id="dec-solicitar-emprestimo" value="<%= currentDecision.payload?.solicitarEmprestimo || 0 %>" oninput="sincronizarInput('solicitar-emprestimo', this.value)">
          </div>

          <!-- Slider Slim -->
          <div class="space-y-1">
            <input type="range" class="slider-slim" min="0" max="100000" step="1000" id="range-solicitar-emprestimo" value="<%= currentDecision.payload?.solicitarEmprestimo || 0 %>" oninput="sincronizarSlider('solicitar-emprestimo', this.value)">
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>R$ 0</span>
              <span>R$ 50.000</span>
              <span>R$ 100.000</span>
            </div>
          </div>

          <!-- Presets Rápidos -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1">
            <span class="text-[10px] text-slate-400 font-medium">Presets:</span>
            <button type="button" class="preset-chip" onclick="aplicarPreset('solicitar-emprestimo', 0)">R$ 0</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('solicitar-emprestimo', 10000)">R$ 10.000</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('solicitar-emprestimo', 25000)">R$ 25.000</button>
            <button type="button" class="preset-chip" onclick="aplicarPreset('solicitar-emprestimo', 50000)">R$ 50.000</button>
          </div>
