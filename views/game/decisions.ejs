// Salvar / Homologar Decisão
async function handleSalvarDecisao(e, statusDesejado) {
  if (e) e.preventDefault();
  
  const salaId = document.querySelector('[data-sala-id]').dataset.salaId;
  const equipeId = document.querySelector('[data-equipe-id]').dataset.equipeId;
  const rodada = parseInt(document.querySelector('[data-rodada]').dataset.rodada, 10);

  const payload = {
    preco: parseFloat(document.getElementById('dec-preco').value),
    marketing: parseFloat(document.getElementById('dec-marketing').value),
    compraEstoqueNormal: parseInt(document.getElementById('dec-compra-normal').value, 10),
    compraEstoqueUrgente: parseInt(document.getElementById('dec-compra-urgente').value, 10),
    solicitarEmprestimo: parseFloat(document.getElementById('dec-solicitar-emprestimo').value),
    amortizarEmprestimo: parseFloat(document.getElementById('dec-amortizar-emprestimo').value)
  };

  const justificativa = {};

  if (window.auroraSocket && window.auroraSocket.connected) {
    const evento = statusDesejado === 'enviada' ? 'decisao:enviar' : 'decisao:rascunho';
    window.auroraSocket.emit(evento, {
      equipeId,
      rodada,
      payload,
      justificativa,
      actionId: `act_${equipeId}_r${rodada}_${statusDesejado}_${Date.now()}`
    }, (res) => {
      if (res && res.sucesso) {
        showToast(statusDesejado === 'enviada' ? 'Decisão final homologada com sucesso!' : 'Rascunho registrado no servidor.', 'sucesso');
        setTimeout(() => window.location.reload(), 600);
      } else {
        showToast((res && res.erro) || 'Erro ao submeter decisão.', 'erro');
      }
    });
  } else {
    showToast('Aguardando sincronização com o servidor...', 'alerta');
  }
}

// Suporte a Atalhos de Teclado (Ctrl+S para Salvar Rascunho, Alt+1..4 para Abas)
window.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
    e.preventDefault();
    handleSalvarDecisao(null, 'rascunho');
  }
  if (e.altKey && ['1', '2', '3', '4'].includes(e.key)) {
    e.preventDefault();
    const idx = parseInt(e.key, 10) - 1;
    if (DIRETORES[idx]) trocarDiretoria(DIRETORES[idx]);
  }
});

// Inicialização imediata
document.addEventListener('DOMContentLoaded', () => {
  atualizarCalculos();

  // Escuta atualizações de rascunho de outros membros da equipe em tempo real
  if (window.auroraSocket) {
    window.auroraSocket.on('decisao:rascunho_atualizado', (decisao) => {
      showToast('Um colega de equipe atualizou os dados do rascunho.', 'info');
      if (decisao && decisao.payload) {
        if (decisao.payload.preco !== undefined) aplicarPreset('preco', decisao.payload.preco);
        if (decisao.payload.marketing !== undefined) aplicarPreset('marketing', decisao.payload.marketing);
        if (decisao.payload.compraEstoqueNormal !== undefined) aplicarPreset('compra-normal', decisao.payload.compraEstoqueNormal);
        if (decisao.payload.compraEstoqueUrgente !== undefined) aplicarPreset('compra-urgente', decisao.payload.compraEstoqueUrgente);
        if (decisao.payload.solicitarEmprestimo !== undefined) aplicarPreset('solicitar-emprestimo', decisao.payload.solicitarEmprestimo);
        if (decisao.payload.amortizarEmprestimo !== undefined) aplicarPreset('amortizar-emprestimo', decisao.payload.amortizarEmprestimo);
      }
    });
  }
});
