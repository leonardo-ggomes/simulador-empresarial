<div class="space-y-6" data-sala-id="<%= currentRoom.id %>" data-sala-codigo="<%= currentRoom.codigo %>">

  <!-- Header Executivo do Briefing -->
  <div class="app-card p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="space-y-1.5">
      <div class="flex items-center gap-2">
        <span class="badge-status badge-status-neutral">
          Rodada <%= currentRoom.rodada_atual %> de 12 • Trimestre <%= ((currentRoom.rodada_atual - 1) % 4) + 1 %> / 2031
        </span>
        <span class="badge-status badge-status-warning">
          <%= macroData.ato.nome %>
        </span>
      </div>
      <h1 class="text-xl font-bold text-slate-900 tracking-tight">
        Briefing Econômico & Inteligência de Mercado
      </h1>
      <p class="text-xs text-slate-500 max-w-2xl leading-relaxed">
        <%= macroData.ato.descricao %>
      </p>
    </div>

    <div class="flex items-center gap-2.5 w-full md:w-auto">
      <a href="/sala/<%= currentRoom.id %>/powerbi" class="btn-secondary text-xs flex-1 md:flex-none">
        Conectar Power BI
      </a>
      <a href="/sala/<%= currentRoom.id %>/decisoes" class="btn-primary text-xs flex-1 md:flex-none">
        Formular Decisões
        <span class="text-slate-400">→</span>
      </a>
    </div>
  </div>

  <!-- Indicadores Macroeconômicos em Tita Financeira -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
    
    <div class="app-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-medium text-slate-500 uppercase tracking-wider">Taxa Selic</span>
        <span class="text-[10px] text-slate-400 font-mono"><%= macroData.selicTrimestral %>% trim.</span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-slate-900 tabular-nums"><%= macroData.selic %>%</span>
        <span class="text-[11px] text-slate-500 font-medium">a.a.</span>
      </div>
      <p class="mt-2 text-[11px] text-slate-500">
        Taxa básica que orienta o custo de empréstimos do Banco Aurora.
      </p>
    </div>

    <div class="app-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-medium text-slate-500 uppercase tracking-wider">Câmbio USD/BRL</span>
        <span class="text-[10px] text-slate-400">Ptax</span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-slate-900 tabular-nums">R$ <%= macroData.cambio.toFixed(2) %></span>
      </div>
      <p class="mt-2 text-[11px] text-slate-500">
        Impacto direto no custo de aquisição de insumos e matérias-primas importadas.
      </p>
    </div>

    <div class="app-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-medium text-slate-500 uppercase tracking-wider">PIB Regional</span>
        <span class="text-[10px] text-slate-400">Variação Real</span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-bold <%= macroData.pibCrescimento >= 0 ? 'text-slate-900' : 'text-rose-600' %> tabular-nums">
          <%= macroData.pibCrescimento >= 0 ? '+' : '' %><%= macroData.pibCrescimento %>%
        </span>
      </div>
      <p class="mt-2 text-[11px] text-slate-500">
        Termômetro da renda média das famílias e disposição ao consumo na região.
      </p>
    </div>

    <div class="app-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-medium text-slate-500 uppercase tracking-wider">Sazonalidade</span>
        <span class="text-[10px] text-slate-400">Multiplicador</span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-slate-900 tabular-nums"><%= macroData.sazonalidade %>x</span>
      </div>
      <p class="mt-2 text-[11px] text-slate-500">
        Fator de modulação da curva de demanda para o ciclo trimestral vigente.
      </p>
    </div>

  </div>

  <!-- Consultor Dado & Orientação Estratégica -->
  <div class="app-card p-5 border-l-4 border-l-slate-900 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-slate-900">Consultoria Analítica • Orientação ao CDO</span>
        <span class="badge-status badge-status-neutral text-[10px]">Tutor Pedagógico</span>
      </div>
      <p class="text-xs text-slate-600 leading-relaxed max-w-3xl">
        "Avalie as notícias com rigor estatístico antes de alterar o planejamento de compras. Falsos boatos no mercado reduzem a acurácia de modelos preditivos. Lembre-se de documentar sua evidência quantitativa no envio da decisão para garantir pontuação máxima de maturidade analítica."
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <button type="button" onclick="abrirDetalhesMacro()" class="btn-secondary text-xs">
        Explicar Parâmetros
      </button>
    </div>
  </div>

  <!-- Gazeta do Porto (Caderno Editorial de Notícias) -->
  <div class="app-card overflow-hidden">
    <!-- Cabeçalho do Jornal -->
    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold tracking-wider uppercase text-slate-900">Gazeta Aurora</span>
          <span class="text-slate-300">•</span>
          <span class="text-xs text-slate-500">Edição Trimestral Oficial (Rodada <%= currentRoom.rodada_atual %>)</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-0.5">Veículo regional de economia, indústria e política regulatória</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-[11px] text-slate-500">
          <%= typeof noticias !== 'undefined' ? noticias.length : 0 %> despachos publicados
        </span>
        <a href="/sala/<%= currentRoom.id %>/gazeta" class="btn-primary text-xs flex items-center gap-1.5 py-1 px-3">
          <span>Abrir Portal Gazeta Aurora</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Lista de Notícias -->
    <div class="p-6">
      <% if (typeof noticias !== 'undefined' && noticias.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% noticias.forEach(noticia => { %>
            <div class="p-4 rounded-lg border border-slate-200 bg-white hover:border-slate-300 transition-colors flex flex-col justify-between space-y-3 cursor-pointer group" onclick="abrirNoticiaSheet('<%= escape(JSON.stringify(noticia)) %>')">
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="badge-status badge-status-neutral uppercase text-[10px]">
                    <%= noticia.categoria %>
                  </span>
                  <% if (noticia.confiabilidade >= 0.8) { %>
                    <span class="badge-status badge-status-success text-[10px]">
                      Confiabilidade: <%= Math.round(noticia.confiabilidade * 100) %>%
                    </span>
                  <% } else if (noticia.confiabilidade >= 0.6) { %>
                    <span class="badge-status badge-status-warning text-[10px]">
                      Confiabilidade: <%= Math.round(noticia.confiabilidade * 100) %>%
                    </span>
                  <% } else { %>
                    <span class="badge-status badge-status-danger text-[10px]">
                      Rumor: <%= Math.round(noticia.confiabilidade * 100) %>%
                    </span>
                  <% } %>
                </div>

                <h3 class="text-sm font-semibold text-slate-900 leading-snug group-hover:text-blue-600 transition-colors">
                  <%= noticia.titulo %>
                </h3>

                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                  <%= noticia.texto %>
                </p>
              </div>

              <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                <span>Efeito: <strong class="text-slate-600 font-medium"><%= noticia.tipo_efeito %></strong></span>
                <span>Duração: <strong class="text-slate-600 font-medium"><%= noticia.duracao_rodadas %> tri.</strong></span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-10 text-xs text-slate-400">
          Nenhuma notícia publicada pelo departamento editorial nesta rodada.
        </div>
      <% } %>
    </div>
  </div>

</div>

<script>
function abrirNoticiaSheet(noticiaJsonEscaped) {
  try {
    const noticia = JSON.parse(unescape(noticiaJsonEscaped));
    const confiabilidadePct = Math.round(noticia.confiabilidade * 100);
    const html = `
      <div class="space-y-4">
        <div>
          <span class="badge-status badge-status-neutral uppercase text-[10px] mb-2">${noticia.categoria}</span>
          <h2 class="text-base font-bold text-slate-900 mt-1 leading-snug">${noticia.titulo}</h2>
        </div>

        <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs space-y-1.5">
          <div class="flex justify-between">
            <span class="text-slate-500">Índice de Confiabilidade:</span>
            <span class="font-semibold text-slate-800">${confiabilidadePct}%</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Tipo de Efeito Projetado:</span>
            <span class="font-semibold text-slate-800">${noticia.tipo_efeito}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Persistência Temporal:</span>
            <span class="font-semibold text-slate-800">${noticia.duracao_rodadas} trimestre(s)</span>
          </div>
        </div>

        <div class="text-xs text-slate-700 leading-relaxed space-y-2">
          <p>${noticia.texto}</p>
        </div>

        <div class="pt-4 border-t border-slate-200 text-xs text-slate-500">
          <strong>Diretriz do CDO:</strong> Ao construir seu modelo preditivo no Power BI ou no simulador, multiplique o impacto do efeito pela confiabilidade nominal de ${confiabilidadePct}% para apurar a expectativa matemática do cenário.
        </div>
      </div>
    `;
    abrirSideSheet('Despacho de Mercado', html);
  } catch (err) {
    console.error(err);
  }
}

function abrirDetalhesMacro() {
  const html = `
    <div class="space-y-4 text-xs text-slate-600 leading-relaxed">
      <div class="space-y-1">
        <h3 class="font-bold text-slate-900 text-sm">Estrutura Macroeconômica de Porto Aurora</h3>
        <p class="text-slate-500">Os indicadores determinam a dinâmica agregada de custos e demanda em cada rodada:</p>
      </div>

      <div class="p-3 border border-slate-200 rounded-lg space-y-1">
        <div class="font-semibold text-slate-800">1. Taxa Selic e Custo de Dívida</div>
        <p>A Selic trimestral é a taxa livre de risco. O spread de crédito do Banco Aurora varia entre 1.8% e 6.5% a.t. dependendo do seu Rating (AAA até C).</p>
      </div>

      <div class="p-3 border border-slate-200 rounded-lg space-y-1">
        <div class="font-semibold text-slate-800">2. Câmbio e Matéria-Prima</div>
        <p>A desvalorização cambial encarece insumos de fornecedores globais, elevando o custo de aquisição de novos lotes de mercadorias.</p>
      </div>

      <div class="p-3 border border-slate-200 rounded-lg space-y-1">
        <div class="font-semibold text-slate-800">3. Sazonalidade & Demanda Agregada</div>
        <p>Variações cíclicas de compra exigem atenção ao estoque de segurança. Evite rupturas para não ceder market share aos competidores.</p>
      </div>
    </div>
  `;
  abrirSideSheet('Manual Macroeconômico', html);
}
</script>
