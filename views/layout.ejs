<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Aurora Business Lab</title>
  
  <!-- Tipografia Inter & Editorial Gazeta -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            serif: ['Newsreader', 'Playfair Display', 'Georgia', 'serif'],
            editorial: ['Newsreader', 'Playfair Display', 'Georgia', 'serif'],
          },
          colors: {
            slate: {
              850: '#151F32',
              950: '#0B0F19'
            }
          }
        }
      }
    }
  </script>

  <!-- GSAP para Microinterações Intencionais -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <!-- Socket.IO Client -->
  <script src="/socket.io/socket.io.js"></script>

  <!-- Design System Refatorado -->
  <link rel="stylesheet" href="/css/aurora.css">
  
  <!-- Scripts Globais do Aurora Lab (Funções utilitárias e Side Sheet) -->
  <script src="/js/app.js"></script>
  
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body class="h-full flex flex-col bg-[#F8FAFC] text-[#0F172A] antialiased">

  <!-- Barra de Navegação Superior (Estilo Linear / Stripe) -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40 select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
      
      <!-- Marca & Contexto de Simulação -->
      <div class="flex items-center gap-6">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 group">
          <div class="w-7 h-7 rounded-lg bg-slate-900 flex items-center justify-center text-white text-xs font-bold tracking-wider">
            AB
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm tracking-tight leading-none text-slate-900">Aurora Lab</span>
            <span class="text-[10px] text-slate-400 font-medium tracking-normal mt-0.5">Porto Aurora 2031</span>
          </div>
        </a>

        <% if (typeof currentRoom !== 'undefined' && currentRoom) { %>
          <div class="hidden sm:flex items-center gap-1.5 pl-4 border-l border-slate-200 text-xs">
            <a href="/lobby" class="text-slate-400 hover:text-slate-900 transition flex items-center gap-1 font-medium" title="Ir para Salas">
              Salas
              <span class="text-slate-300">/</span>
            </a>
            <span class="font-semibold text-slate-800 truncate max-w-[140px]"><%= currentRoom.nome %></span>
            <span class="text-slate-300">•</span>
            <span class="text-slate-600 font-mono text-[11px] bg-slate-100 px-1.5 py-0.5 rounded">R<%= currentRoom.rodada_atual %>/<%= currentRoom.max_rodadas %></span>
          </div>
        <% } %>
      </div>

      <!-- Navegação Central de Fluxos (Slim & Espaçada) -->
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <nav class="hidden md:flex items-center gap-1 text-xs font-medium text-slate-600">
        <% if (typeof currentRoom !== 'undefined' && currentRoom) { %>
          <% 
            const isGazeta = typeof title !== 'undefined' && title && title.includes('Gazeta');
            const isDecisoes = typeof title !== 'undefined' && title && title.includes('Decis');
            const isRanking = typeof title !== 'undefined' && title && title.includes('Ranking');
            const isPowerBI = typeof title !== 'undefined' && title && title.includes('Power BI');
            const isMaisActive = typeof title !== 'undefined' && title && (title.includes('Briefing') || title.includes('Demonstrativos') || title.includes('Laborat') || title.includes('Análise') || title.includes('Galpão'));
          %>
          <!-- 1. Gazeta Aurora -->
          <a href="/sala/<%= currentRoom.id %>/gazeta" class="px-2.5 py-1.5 rounded-md hover:bg-slate-100 transition flex items-center gap-1.5 <%= isGazeta ? 'text-slate-900 bg-slate-100 font-semibold' : 'text-slate-700 font-medium' %>">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            Gazeta
          </a>

          <!-- 2. Decisões -->
          <a href="/sala/<%= currentRoom.id %>/decisoes" class="px-2.5 py-1.5 rounded-md hover:text-slate-900 hover:bg-slate-100 transition <%= isDecisoes ? 'text-slate-900 bg-slate-100 font-semibold' : '' %>">
            Decisões
          </a>

          <!-- 3. Ranking -->
          <a href="/sala/<%= currentRoom.id %>/ranking" class="px-2.5 py-1.5 rounded-md hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 <%= isRanking ? 'text-amber-800 bg-amber-50/80 font-semibold' : '' %>">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            Ranking
          </a>

          <!-- 4. Power BI -->
          <a href="/sala/<%= currentRoom.id %>/powerbi" class="px-2.5 py-1.5 rounded-md text-blue-600 font-semibold bg-blue-50/60 hover:bg-blue-100/60 transition flex items-center gap-1.5 <%= isPowerBI ? 'ring-1 ring-blue-300' : '' %>">
            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            Power BI
          </a>

          <!-- 5. Dropdown 'Mais ▾' (Briefing, Demonstrativos, Lab Web) -->
          <div class="relative inline-block text-left" id="nav-dropdown-mais-container">
            <button id="btn-dropdown-mais" onclick="toggleDropdownMais(event)" type="button"
                    class="px-2.5 py-1.5 rounded-md transition flex items-center gap-1 text-slate-600 hover:text-slate-900 hover:bg-slate-100 font-medium <%= isMaisActive ? 'text-slate-900 bg-slate-100 font-semibold' : '' %>">
              <span>Mais</span>
              <svg class="w-3 h-3 text-slate-400 transition-transform duration-150" id="icon-dropdown-mais" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <div id="dropdown-menu-mais" class="hidden absolute right-0 mt-1.5 w-56 rounded-lg bg-white border border-slate-200/90 shadow-md py-1 z-50">
              <a href="/sala/<%= currentRoom.id %>/galpao" id="nav-link-galpao" class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                <div>
                  <div class="font-medium text-slate-900 flex items-center gap-1.5">Galpão 3D <span class="text-[9px] font-bold px-1 rounded bg-cyan-50 text-cyan-700 border border-cyan-200">CAD</span></div>
                  <div class="text-[10px] text-slate-400">Ocupação e posições de estoque</div>
                </div>
              </a>
              <a href="/sala/<%= currentRoom.id %>/resultados" class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <div>
                  <div class="font-medium text-slate-900">Demonstrativos</div>
                  <div class="text-[10px] text-slate-400">DRE, Balanço e DFC</div>
                </div>
              </a>
              <a href="/sala/<%= currentRoom.id %>/analise" class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                <div>
                  <div class="font-medium text-slate-900">Lab Web</div>
                  <div class="text-[10px] text-slate-400">Análise e gráficos prévios</div>
                </div>
              </a>
              <a href="/sala/<%= currentRoom.id %>/briefing" class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                <div>
                  <div class="font-medium text-slate-900">Briefing da Rodada</div>
                  <div class="text-[10px] text-slate-400">Cenário macro e diretrizes</div>
                </div>
              </a>
              <div class="my-1 border-t border-slate-100"></div>
              <a href="/lobby" class="flex items-center gap-2.5 px-3 py-1.5 text-xs text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                <span>Trocar de Sala</span>
              </a>
            </div>
          </div>

          <!-- 6. Controle Facilitador (se professor) -->
          <% if (currentUser.perfil === 'professor' || currentUser.perfil === 'admin') { %>
            <a href="/sala/<%= currentRoom.id %>/professor" class="px-2.5 py-1.5 rounded-md text-amber-800 bg-amber-50 hover:bg-amber-100 font-medium transition border border-amber-200/60 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Controle
            </a>
          <% } %>
        <% } else { %>
          <a href="/lobby" class="px-2.5 py-1.5 rounded-md text-slate-900 bg-slate-100 font-semibold">Salas</a>
        <% } %>
      </nav>
      <% } %>

      <!-- Lado Direito: Status e Conta -->
      <div class="flex items-center gap-3">
        <!-- Indicador de Status WebSocket -->
        <div id="socket-status" class="flex items-center gap-1.5 text-[11px] text-slate-500 bg-slate-50 border border-slate-200 px-2 py-0.5 rounded-full" title="Conexão ao servidor">
          <span id="socket-dot" class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
          <span id="socket-text" class="hidden sm:inline">Conectando</span>
        </div>

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="flex items-center gap-2 pl-3 border-l border-slate-200">
            <div class="text-right hidden sm:block">
              <div class="text-xs font-medium text-slate-800 leading-tight"><%= currentUser.nome %></div>
              <div class="text-[10px] text-slate-400 capitalize"><%= currentUser.perfil %></div>
            </div>
            <button onclick="fazerLogout()" class="text-xs text-slate-500 hover:text-rose-600 px-2 py-1 rounded transition" title="Sair da conta">
              Sair
            </button>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn-primary text-xs py-1.5 px-3">Entrar</a>
        <% } %>
      </div>

    </div>
  </header>

  <!-- Área de Trabalho / Conteúdo Principal -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <%- body %>
  </main>

  <!-- Rodapé Institucional Discreto -->
  <footer class="border-t border-slate-200 bg-white py-3 text-center text-[11px] text-slate-400">
    Aurora Business Lab 2031 • Simulação Empresarial & Engenharia de Dados
  </footer>

  <!-- Side Sheet Contextual Reutilizável (Gaveta Lateral GSAP) -->
  <div id="side-sheet-backdrop" class="side-sheet-backdrop" onclick="fecharSideSheet()"></div>
  <aside id="side-sheet-panel" class="side-sheet-panel" aria-modal="true" role="dialog">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
      <div id="side-sheet-title" class="text-sm font-bold text-slate-900">Detalhes</div>
      <button onclick="fecharSideSheet()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md text-sm transition">
        ✕
      </button>
    </div>
    <div id="side-sheet-content" class="flex-1 overflow-y-auto p-6 space-y-4">
      <!-- Conteúdo inserido dinamicamente via JS -->
    </div>
  </aside>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

  <!-- Scripts Globais -->
  <script src="/js/app.js"></script>
  <script>
    function toggleDropdownMais(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const menu = document.getElementById('dropdown-menu-mais');
      const icon = document.getElementById('icon-dropdown-mais');
      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        if (icon) icon.classList.add('rotate-180');
      } else {
        menu.classList.add('hidden');
        if (icon) icon.classList.remove('rotate-180');
      }
    }

    document.addEventListener('click', function(e) {
      const container = document.getElementById('nav-dropdown-mais-container');
      if (container && !container.contains(e.target)) {
        const menu = document.getElementById('dropdown-menu-mais');
        const icon = document.getElementById('icon-dropdown-mais');
        if (menu && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          if (icon) icon.classList.remove('rotate-180');
        }
      }
    });
  </script>
</body>
</html>
